{
  "name": "ai-token-diff",
  "version": "0.1.1",
  "description": "Deterministic token usage measurement and context diff infrastructure for LLM workflows.",
  "type": "module",
  "bin": {
    "token-diff": "dist/cli.js",
    "ai-token-diff": "dist/cli.js",
    "td": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.vi.md",
    "assets",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepack": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khoa180806/token-diff.git"
  },
  "homepage": "https://github.com/Khoa180806/token-diff#readme",
  "bugs": {
    "url": "https://github.com/Khoa180806/token-diff/issues"
  },
  "keywords": [
    "token",
    "diff",
    "llm",
    "ai",
    "tiktoken",
    "context",
    "measurement",
    "cli",
    "agent"
  ],
  "author": "Khoa180806",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "js-tiktoken": "^1.0.15",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
